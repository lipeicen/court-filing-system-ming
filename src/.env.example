# 浏览器配置
BROWSER_HEADLESS=true
BROWSER_POOL_SIZE=5
BROWSER_TIMEOUT=30000

# 验证码配置
CAPTCHA_API_KEY=your_api_key_here
CAPTCHA_API_URL=https://api.captcha-service.com/solve

# 北京法院账号
BEIJING_COURT_USERNAME=your_username
BEIJING_COURT_PASSWORD=your_password

# 上海法院账号
SHANGHAI_COURT_USERNAME=your_username
SHANGHAI_COURT_PASSWORD=your_password

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=logs/filing.log

# 截图配置
SCREENSHOT_DIR=screenshots

# 文档配置
DOCUMENT_DIR=documents
